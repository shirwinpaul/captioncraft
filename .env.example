# Copy this file to `.env.local` and fill in your keys.
# These are read ONLY on the server (API routes). Never prefix them with NEXT_PUBLIC_.

# Primary AI provider — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback AI provider — free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: max AI generations per IP per hour (default 20).
# RATE_LIMIT_PER_HOUR=20

# Optional, development only: return sample captions without calling any AI.
# Ignored in production builds.
# MOCK_AI=true
